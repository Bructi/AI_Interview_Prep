PORT=5000
# MongoDB Atlas cloud URI (required for production — local 127.0.0.1 won't work on Vercel)
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/interview-prep?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
GEMINI_API_KEY=your_google_gemini_api_key
# Your deployed Vercel frontend URL (with trailing slash removed)
CLIENT_URL=https://hone.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
