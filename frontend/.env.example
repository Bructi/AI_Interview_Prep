# Supabase (required for auth + storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_anon_key

# Backend API URL (set this to your deployed backend, e.g. https://api-hone.vercel.app)
# In development this falls back to '/api' via the vite proxy
VITE_API_URL=https://api-hone.vercel.app
